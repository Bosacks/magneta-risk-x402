{
  "name": "magneta-risk-x402",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Magneta Contract Risk: on-chain smart-contract risk reports sold to AI agents through x402 micropayments (HTTP + MCP)",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "type-check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "analyze": "tsx scripts/analyze.ts",
    "buy-once": "tsx scripts/buy-once.ts",
    "buy-once-mcp": "tsx scripts/buy-once-mcp.ts"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.58.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/extensions": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/mcp": "2.28.0",
    "@x402/svm": "2.28.0",
    "dotenv": "18.0.8",
    "express": "4.22.3",
    "viem": "2.57.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "20.19.43",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
