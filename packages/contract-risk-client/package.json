{
  "name": "@magnetafinance/contract-risk",
  "version": "0.1.1",
  "private": false,
  "description": "Client for the Magneta Contract Risk x402 service: smart-contract risk reports for AI agents on 20 EVM chains ($0.02 USDC per report, free quick flags), plus LangChain.js / Vercel AI SDK tool adapters.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bosacks/magneta-risk-x402.git",
    "directory": "packages/contract-risk-client"
  },
  "homepage": "https://x402.magneta.finance",
  "keywords": [
    "x402",
    "mcp",
    "smart-contract",
    "risk",
    "agents",
    "langchain",
    "ai-sdk",
    "base",
    "usdc"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "viem": "2.57.7"
  }
}
