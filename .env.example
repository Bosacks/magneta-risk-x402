# Listening port
PORT=3011

# x402 payment settings
PAY_TO=0xYourReceivingAddress
# eip155:84532 = Base Sepolia (default), eip155:8453 = Base mainnet
X402_NETWORK=eip155:84532
# "cdp" = Coinbase CDP facilitator (needs the two CDP_* keys), or an HTTP facilitator URL
FACILITATOR_URL=https://x402.org/facilitator
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Static analysis (aderyn 0.6.8)
ADERYN_BIN=/home/dominique/bin/aderyn

# Optional RPC overrides, RPC_URL_<chainId> (defaults are public RPCs in src/chains.ts)
# RPC_URL_8453=https://...
# RPC_URL_84532=https://...
# RPC_URL_1=https://...
# RPC_URL_42161=https://...

# Only used by scripts/buy-once*.ts (never set on the server)
# BUYER_PRIVATE_KEY=0x...
# TARGET_URL=http://127.0.0.1:3011/v1/risk/84532/0x036CbD53842c5426634e7929541eC2318f3dCF7e
# MCP_URL=http://127.0.0.1:3011/mcp

# Public base URL (https), used as the MCP resource URL for Bazaar discovery
PUBLIC_URL=https://x402.magneta.finance

# Optional second payment network: USDC on Solana (mainnet when X402_NETWORK is eip155:8453, devnet otherwise)
SOLANA_PAY_TO=
